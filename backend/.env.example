# ==========================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR (EC2 / Render / Cloud)
# ==========================================
PORT=3000
NODE_ENV=production

# URL pública de acceso (Ej: https://tudominio.com, http://<IP_PUBLICA_EC2>:3000 o https://tu-app.onrender.com)
APP_URL=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# ==========================================
# BASE DE DATOS (MySQL / TiDB Cloud / RDS)
# ==========================================
DB_HOST=db
DB_PORT=3306
DB_USER=reservas_app
DB_PASSWORD=secret_app_password
DB_NAME=reservas_db

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
JWT_SECRET=generar_clave_segura_jwt_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=8h

# ==========================================
# SERVICIO DE CORREO TRANSACCIONAL (EMAIL)
# ==========================================
# Opciones para EMAIL_PROVIDER: 'resend', 'brevo', o 'mock'
EMAIL_PROVIDER=resend
EMAIL_FROM=reservas@tudominio.com
EMAIL_FROM_NAME="SportReserve Platform"

# Si usas Resend:
RESEND_API_KEY=

# Si usas Brevo (Sendinblue):
BREVO_API_KEY=

# ==========================================
# PASARELA DE PAGO ONLINE
# ==========================================
# Opciones para PAYMENT_GATEWAY_PROVIDER: 'flow', 'stripe', o 'mock'
PAYMENT_GATEWAY_PROVIDER=flow

# Si usas Flow:
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=production # 'production' o 'sandbox'

# Si usas Stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
