# ==========================================
# BASE DE DATOS (MySQL Docker / Cloud DB)
# ==========================================
MYSQL_ROOT_PASSWORD=cambiar_por_clave_root_segura_2026
MYSQL_DATABASE=reservas_db
MYSQL_USER=reservas_app
MYSQL_PASSWORD=cambiar_por_clave_app_segura_2026
MYSQL_PORT=3307

# ==========================================
# SERVIDOR BACKEND (AWS EC2 / Render / Cloud)
# ==========================================
BACKEND_PORT=3000
NODE_ENV=production

# URL pública de acceso (Ej: https://tudominio.com, http://<IP_PUBLICA_EC2>:3000 o https://tu-app.onrender.com)
APP_URL=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# Seguridad JWT
JWT_SECRET=generar_clave_segura_jwt_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=8h

# ==========================================
# SERVICIO DE CORREO TRANSACCIONAL (EMAIL)
# ==========================================
# Opciones para EMAIL_PROVIDER:
#  - 'resend' -> Envío real mediante Resend API (https://resend.com)
#  - 'brevo'  -> Envío real mediante Brevo API (https://brevo.com)
#  - 'mock'   -> Simulación en consola de Docker
EMAIL_PROVIDER=resend
EMAIL_FROM=reservas@tudominio.com
EMAIL_FROM_NAME="SportReserve Platform"

# Si usas Resend:
RESEND_API_KEY=

# Si usas Brevo (Sendinblue):
BREVO_API_KEY=

# ==========================================
# PASARELA DE PAGO ONLINE
# ==========================================
# Opciones para PAYMENT_GATEWAY_PROVIDER:
#  - 'flow'   -> Pasarela Flow (https://www.flow.cl)
#  - 'stripe' -> Pasarela Stripe (https://stripe.com)
#  - 'mock'   -> Simulador visual integrado
PAYMENT_GATEWAY_PROVIDER=flow

# Credenciales Flow:
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=production # 'production' o 'sandbox'

# Credenciales Stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
