# ==========================================
# BASE DE DATOS (MySQL Docker)
# ==========================================
MYSQL_ROOT_PASSWORD=secret_root_password
MYSQL_DATABASE=reservas_db
MYSQL_USER=reservas_app
MYSQL_PASSWORD=secret_app_password
MYSQL_PORT=3307

# ==========================================
# BACKEND Y SEGURIDAD
# ==========================================
BACKEND_PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# ==========================================
# SERVICIO DE CORREO TRANSACCIONAL (EMAIL)
# ==========================================
# Proveedor: 'mock' (por defecto en local), 'resend', o 'brevo'
EMAIL_PROVIDER=mock
EMAIL_FROM=reservas@sportreserve.com
EMAIL_FROM_NAME="SportReserve Platform"

# Credenciales de Email (Completar para envíos reales):
RESEND_API_KEY=
BREVO_API_KEY=

# ==========================================
# PASARELA DE PAGO ONLINE
# ==========================================
# Proveedor: 'mock' (simulador integrado por defecto), 'flow', o 'stripe'
PAYMENT_GATEWAY_PROVIDER=mock

# Credenciales Flow (https://www.flow.cl):
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox # 'sandbox' o 'production'

# Credenciales Stripe (https://stripe.com):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
