# ==========================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ==========================================
# BASE DE DATOS (MySQL Docker)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=reservas_app
DB_PASSWORD=secret_app_password
DB_NAME=reservas_db

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# ==========================================
# SERVICIO DE CORREO TRANSACCIONAL (EMAIL)
# ==========================================
# Opciones para EMAIL_PROVIDER:
#  - 'mock'   -> Simulación en consola (por defecto para desarrollo local)
#  - 'resend' -> Envío real mediante Resend API (https://resend.com)
#  - 'brevo'  -> Envío real mediante Brevo API (https://brevo.com)
EMAIL_PROVIDER=mock
EMAIL_FROM=reservas@sportreserve.com
EMAIL_FROM_NAME="SportReserve Platform"

# Si usas Resend:
RESEND_API_KEY=

# Si usas Brevo (Sendinblue):
BREVO_API_KEY=

# ==========================================
# PASARELA DE PAGO ONLINE (CHECKOUT)
# ==========================================
# Opciones para PAYMENT_GATEWAY_PROVIDER:
#  - 'mock'   -> Simulador visual local en /api/pagos/online/sandbox-checkout (por defecto)
#  - 'flow'   -> Pasarela Flow (https://www.flow.cl)
#  - 'stripe' -> Pasarela Stripe (https://stripe.com)
PAYMENT_GATEWAY_PROVIDER=mock

# Si usas Flow:
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox # Opciones: 'sandbox' o 'production'

# Si usas Stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
